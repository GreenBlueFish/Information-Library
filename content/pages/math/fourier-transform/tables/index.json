        "Synthesis (back to the signal)"
      ],
      "rows": [
        [
          "Fourier series",
          "periodic, continuous (period $T$)",
          "$c_k = \\frac{1}{T}\\int_{0}^{T} x(t)\\, e^{-j2\\pi k t/T}\\, dt$",
          "$x(t) = \\sum_{k=-\\infty}^{\\infty} c_k\\, e^{j2\\pi k t/T}$"
        ],
        [
          "Fourier transform",
          "continuous, any length",
          "$X(f) = \\int_{-\\infty}^{\\infty} x(t)\\, e^{-j2\\pi f t}\\, dt$",
          "$x(t) = \\int_{-\\infty}^{\\infty} X(f)\\, e^{j2\\pi f t}\\, df$"
        ],
        [
          "DTFT",
          "sampled, any length",
          "$X(e^{j\\omega}) = \\sum_{n=-\\infty}^{\\infty} x[n]\\, e^{-j\\omega n}$",
          "$x[n] = \\frac{1}{2\\pi}\\int_{-\\pi}^{\\pi} X(e^{j\\omega})\\, e^{j\\omega n}\\, d\\omega$"
        ],
        [
          "DFT (computed by the FFT)",
          "sampled, $N$ samples",
          "$X[k] = \\sum_{n=0}^{N-1} x[n]\\, e^{-j2\\pi k n/N}$",
          "$x[n] = \\frac{1}{N}\\sum_{k=0}^{N-1} X[k]\\, e^{j2\\pi k n/N}$"
        ]
      ],
      "caption": "A signal that repeats has a spectrum of separate lines; a sampled signal has a spectrum that repeats. The DFT is both."
    },
