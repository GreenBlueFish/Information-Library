          "$x^*(t)$",
          "$X^*(s^*)$",
          "$R_x$"
        ],
        [
          "Convolution",
          "$x(t) * y(t)$",
          "$X(s)\\, Y(s)$",
          "contains $R_x \\cap R_y$"
        ],
        [
          "Differentiation in time",
          "$\\frac{dx}{dt}$",
          "$s X(s)$",
          "contains $R_x$"
        ],
        [
