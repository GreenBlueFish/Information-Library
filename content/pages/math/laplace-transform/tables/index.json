          "$t\\, x(t)$",
          "$-\\frac{dX}{ds}$",
          "$R_x$"
        ],
        [
          "Integration",
          "$\\int_{-\\infty}^{t} x(\\tau)\\, d\\tau$",
          "$\\frac{X(s)}{s}$",
