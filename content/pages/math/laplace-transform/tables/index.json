          "$x(at),\\ a \\ne 0$",
          "$\\frac{1}{|a|} X\\!\\left(\\frac{s}{a}\\right)$",
          "$a R_x$"
        ],
        [
          "Time reversal",
          "$x(-t)$",
          "$X(-s)$",
          "$-R_x$"
        ],
        [
